{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile data including roles and basic info.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "member"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Player": {
      "title": "Player",
      "description": "Club player profile and statistics.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "number": { "type": "integer" },
        "position": { "type": "string", "enum": ["Goalkeeper", "Defender", "Midfielder", "Forward"] },
        "image": { "type": "string" },
        "nationality": { "type": "string" },
        "birthDate": { "type": "string" },
        "height": { "type": "string" },
        "weight": { "type": "string" },
        "bio": { "type": "string" },
        "stats": {
          "type": "object",
          "properties": {
            "appearances": { "type": "integer" },
            "goals": { "type": "integer" },
            "assists": { "type": "integer" },
            "cleanSheets": { "type": "integer" },
            "yellowCards": { "type": "integer" },
            "redCards": { "type": "integer" }
          }
        }
      },
      "required": ["name", "number", "position"]
    },
    "Match": {
      "title": "Match",
      "description": "Fixture or completed match result.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "homeTeamId": { "type": "string" },
        "awayTeamId": { "type": "string" },
        "homeTeamName": { "type": "string" },
        "awayTeamName": { "type": "string" },
        "homeScore": { "type": "integer" },
        "awayScore": { "type": "integer" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "venue": { "type": "string" },
        "competition": { "type": "string" },
        "status": { "type": "string", "enum": ["upcoming", "live", "completed", "postponed", "cancelled"] },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["goal", "yellow_card", "red_card", "substitution"] },
              "minute": { "type": "integer" },
              "playerId": { "type": "string" },
              "assistId": { "type": "string" },
              "playerOutId": { "type": "string" }
            }
          }
        }
      },
      "required": ["opponent", "date", "status"]
    },
    "NewsArticle": {
      "title": "News Article",
      "description": "Club news and updates.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "image": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "author": { "type": "string" }
      },
      "required": ["title", "content", "date"]
    },
    "Competition": {
      "title": "Competition",
      "description": "Leagues or tournaments the club participates in.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "season": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "type": { "type": "string", "enum": ["league", "cup", "tournament"] },
        "active": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "completed", "upcoming"] }
      },
      "required": ["name", "season", "type"]
    },
    "Trophy": {
      "title": "Trophy",
      "description": "Club achievements and trophies.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "competition": { "type": "string" },
        "season": { "type": "string" },
        "image": { "type": "string" },
        "achievement": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["competition", "season", "achievement"]
    },
    "Team": {
      "title": "Team",
      "description": "Opponent teams or club's own teams.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "logo": { "type": "string" },
        "image": { "type": "string" },
        "color": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "captainId": { "type": "string" },
        "coach": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["name", "shortName"]
    },
    "GalleryImage": {
      "title": "Gallery Image",
      "description": "Images in the club gallery.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "caption": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["url"]
    },
    "ClubSettings": {
      "title": "Club Settings",
      "description": "Global configuration and info for the club.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "founded": { "type": "string" },
        "logo": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "stadium": { "type": "string" },
        "ground": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "address": { "type": "string" },
            "latitude": { "type": "number" },
            "longitude": { "type": "number" },
            "mapsUrl": { "type": "string" }
          }
        },
        "history": { "type": "string" },
        "vision": { "type": "string" },
        "mission": { "type": "string" },
        "socials": { "type": "object" },
        "contact": { "type": "object" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles."
    },
    "/players/{playerId}": {
      "schema": "Player",
      "description": "Club players."
    },
    "/matches/{matchId}": {
      "schema": "Match",
      "description": "Matches and fixtures."
    },
    "/news/{articleId}": {
      "schema": "NewsArticle",
      "description": "News articles."
    },
    "/teams/{teamId}": {
      "schema": "Team",
      "description": "Opponent and club teams."
    },
    "/competitions/{compId}": {
      "schema": "Competition",
      "description": "Football competitions."
    },
    "/trophies/{trophyId}": {
      "schema": "Trophy",
      "description": "Club trophies."
    },
    "/gallery/{imageId}": {
      "schema": "GalleryImage",
      "description": "Gallery images."
    },
    "/settings/club": {
      "schema": "ClubSettings",
      "description": "Global club settings (single document)."
    }
  }
}
